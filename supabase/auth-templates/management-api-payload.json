{
  "mailer_subjects_confirmation": "Velkommen til SoulEvents 🌿 Bekræft din e-mail",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"da\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Velkommen til SoulEvents</title>\n  </head>\n  <body style=\"margin:0;background:#FAF7F2;color:#4B5645;font-family:Montserrat,Arial,sans-serif;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FAF7F2;padding:32px 16px;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#FFFFFF;border-radius:24px;box-shadow:0 10px 30px rgba(0,0,0,0.08);overflow:hidden;\">\n            <tr>\n              <td align=\"center\" style=\"padding:34px 28px 10px;\">\n                <img src=\"{{ .SiteURL }}/brand/soulevents-email-logo.png\" alt=\"SoulEvents\" width=\"220\" height=\"70\" style=\"display:block;width:210px;max-width:100%;height:auto;margin:0 auto;border:0;outline:none;text-decoration:none;\" />\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:10px 32px 34px;\">\n                <h1 style=\"margin:0;color:#4B5645;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1.15;font-weight:600;text-align:center;\">Velkommen til SoulEvents</h1>\n                <p style=\"margin:22px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Tak fordi du har oprettet en facilitatorprofil på SoulEvents.</p>\n                <p style=\"margin:14px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">For at aktivere din profil skal du bekræfte din e-mailadresse ved at klikke på knappen herunder.</p>\n                <p style=\"margin:14px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Når din e-mail er bekræftet, kan du logge ind på SoulEvents, færdiggøre din profil og oprette dit første event, mens vi gennemgår din facilitatorprofil.</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px auto 0;\">\n                  <tr>\n                    <td align=\"center\" bgcolor=\"#4B5645\" style=\"border-radius:16px;\">\n                      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 24px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px;border-radius:16px;\">Bekræft min e-mail</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis knappen ikke virker, kan du kopiere linket nedenfor og indsætte det i din browser.</p>\n                <p style=\"margin:8px 0 0;font-size:12px;line-height:1.6;color:#6F756B;word-break:break-all;\">{{ .ConfirmationURL }}</p>\n                <p style=\"margin:28px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Vi glæder os til at byde dig velkommen i SoulEvents-fællesskabet ❤️</p>\n                <p style=\"margin:24px 0 0;font-size:15px;line-height:1.6;color:#4B5645;font-weight:700;\">SoulEvents.dk<br /><span style=\"font-weight:400;color:#6F756B;\">Events for krop, sind og sjæl</span></p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_magic_link": "Log ind på SoulEvents",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"da\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Log ind på SoulEvents</title>\n  </head>\n  <body style=\"margin:0;background:#FAF7F2;color:#4B5645;font-family:Montserrat,Arial,sans-serif;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FAF7F2;padding:32px 16px;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#FFFFFF;border-radius:24px;box-shadow:0 10px 30px rgba(0,0,0,0.08);overflow:hidden;\">\n            <tr>\n              <td align=\"center\" style=\"padding:34px 28px 10px;\">\n                <img src=\"{{ .SiteURL }}/brand/soulevents-email-logo.png\" alt=\"SoulEvents\" width=\"220\" height=\"70\" style=\"display:block;width:210px;max-width:100%;height:auto;margin:0 auto;border:0;outline:none;text-decoration:none;\" />\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:10px 32px 34px;\">\n                <h1 style=\"margin:0;color:#4B5645;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1.15;font-weight:600;text-align:center;\">Dit login-link er klar</h1>\n                <p style=\"margin:22px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Klik på knappen herunder for at logge ind på SoulEvents.</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px auto 0;\">\n                  <tr>\n                    <td align=\"center\" bgcolor=\"#4B5645\" style=\"border-radius:16px;\">\n                      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 24px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px;border-radius:16px;\">Log ind på SoulEvents</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis knappen ikke virker, kan du kopiere linket nedenfor og indsætte det i din browser.</p>\n                <p style=\"margin:8px 0 0;font-size:12px;line-height:1.6;color:#6F756B;word-break:break-all;\">{{ .ConfirmationURL }}</p>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis du ikke har anmodet om dette login-link, kan du se bort fra denne e-mail.</p>\n                <p style=\"margin:24px 0 0;font-size:15px;line-height:1.6;color:#4B5645;font-weight:700;\">SoulEvents.dk<br /><span style=\"font-weight:400;color:#6F756B;\">Events for krop, sind og sjæl</span></p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_recovery": "Nulstil din adgangskode",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"da\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Nulstil din adgangskode</title>\n  </head>\n  <body style=\"margin:0;background:#FAF7F2;color:#4B5645;font-family:Montserrat,Arial,sans-serif;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FAF7F2;padding:32px 16px;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#FFFFFF;border-radius:24px;box-shadow:0 10px 30px rgba(0,0,0,0.08);overflow:hidden;\">\n            <tr>\n              <td align=\"center\" style=\"padding:34px 28px 10px;\">\n                <img src=\"{{ .SiteURL }}/brand/soulevents-email-logo.png\" alt=\"SoulEvents\" width=\"220\" height=\"70\" style=\"display:block;width:210px;max-width:100%;height:auto;margin:0 auto;border:0;outline:none;text-decoration:none;\" />\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:10px 32px 34px;\">\n                <h1 style=\"margin:0;color:#4B5645;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1.15;font-weight:600;text-align:center;\">Opret en ny adgangskode</h1>\n                <p style=\"margin:22px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Vi har modtaget en anmodning om at nulstille adgangskoden til din SoulEvents-profil.</p>\n                <p style=\"margin:14px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Klik på knappen herunder for at vælge en ny adgangskode.</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px auto 0;\">\n                  <tr>\n                    <td align=\"center\" bgcolor=\"#4B5645\" style=\"border-radius:16px;\">\n                      <a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 24px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px;border-radius:16px;\">Nulstil adgangskode</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis knappen ikke virker, kan du kopiere linket nedenfor og indsætte det i din browser.</p>\n                <p style=\"margin:8px 0 0;font-size:12px;line-height:1.6;color:#6F756B;word-break:break-all;\">{{ .ConfirmationURL }}</p>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis du ikke har anmodet om dette, kan du se bort fra denne e-mail.</p>\n                <p style=\"margin:24px 0 0;font-size:15px;line-height:1.6;color:#4B5645;font-weight:700;\">SoulEvents.dk<br /><span style=\"font-weight:400;color:#6F756B;\">Events for krop, sind og sjæl</span></p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "mailer_subjects_email_change": "Bekræft din nye e-mailadresse",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"da\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Bekræft din nye e-mailadresse</title>\n  </head>\n  <body style=\"margin:0;background:#FAF7F2;color:#4B5645;font-family:Montserrat,Arial,sans-serif;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FAF7F2;padding:32px 16px;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#FFFFFF;border-radius:24px;box-shadow:0 10px 30px rgba(0,0,0,0.08);overflow:hidden;\">\n            <tr>\n              <td align=\"center\" style=\"padding:34px 28px 10px;\">\n                <img src=\"{{ .SiteURL }}/brand/soulevents-email-logo.png\" alt=\"SoulEvents\" width=\"220\" height=\"66\" style=\"display:block;width:210px;max-width:100%;height:auto;margin:0 auto;border:0;outline:none;text-decoration:none;\" />\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:10px 32px 34px;\">\n                <h1 style=\"margin:0;color:#4B5645;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1.15;font-weight:600;text-align:center;\">Bekræft din nye e-mailadresse</h1>\n                <p style=\"margin:22px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Vi har modtaget en anmodning om at ændre e-mailadressen på din SoulEvents-profil.</p>\n                <p style=\"margin:14px 0 0;font-size:16px;line-height:1.7;color:#4B5645;\">Klik på knappen herunder for at bekræfte {{ .NewEmail }} som din nye e-mailadresse.</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px auto 0;\">\n                  <tr>\n                    <td align=\"center\" bgcolor=\"#4B5645\" style=\"border-radius:16px;\">\n                      <a href=\"{{ .RedirectTo }}&amp;token_hash={{ .TokenHash }}&amp;type=email_change\" style=\"display:inline-block;padding:14px 24px;color:#FFFFFF;text-decoration:none;font-weight:700;font-size:15px;border-radius:16px;\">Bekræft ny e-mail</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis knappen ikke virker, kan du kopiere linket nedenfor og indsætte det i din browser.</p>\n                <p style=\"margin:8px 0 0;font-size:12px;line-height:1.6;color:#6F756B;word-break:break-all;\">{{ .RedirectTo }}&amp;token_hash={{ .TokenHash }}&amp;type=email_change</p>\n                <p style=\"margin:28px 0 0;font-size:14px;line-height:1.7;color:#6F756B;\">Hvis du ikke har anmodet om dette, kan du se bort fra denne e-mail.</p>\n                <p style=\"margin:24px 0 0;font-size:15px;line-height:1.6;color:#4B5645;font-weight:700;\">SoulEvents.dk<br /><span style=\"font-weight:400;color:#6F756B;\">Events for krop, sind og sjæl</span></p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
}
