{
  "name": "soulevents",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS-platform for events, facilitatorer og fællesskaber i Danmark.",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "dev:local": "npm run db:start && next dev --webpack -p 3001",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "dev:3000": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "start:3000": "next start -p 3000",
    "preview": "npm run build && npm run start",
    "lint": "eslint .",
    "test:onboarding-draft": "node --test src/lib/facilitators/profile-location-save-validation.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.17.0",
    "mapbox-gl": "^3.24.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  }
}
